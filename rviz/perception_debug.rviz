Panels:
  - Class: rviz_default_plugins/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /MarkerArray1
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: StaticFieldPCD
      Topic: /dynamic_obj_detector/map_cloud
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RawLidarCloud
      Topic: /livox/lidar
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: DynamicCloud
      Topic: /dynamic_obj_detector/dynamic_cloud
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: StaticMarkers
      Topic: /static_obj_detector/debug_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: DynamicMarkers
      Topic: /dynamic_obj_detector/debug_markers
      Value: true
  Global Options:
    Fixed Frame: map
