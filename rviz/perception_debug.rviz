Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /StaticFieldPCD1
        - /RawLidarCloud1
        - /DynamicCloud1
        - /StaticMarkers1
        - /DynamicMarkers1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
    Property Tree Widget:
      Expanded:
        - /Current1
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Plane: XY
      Cell Size: 1.0
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: StaticFieldPCD
      Topic: /dynamic_obj_detector/map_cloud
      Value: true
      Color Transformer: FlatColor
      Color: 200; 200; 200
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Name: RawLidarCloud
      Topic: /livox/lidar
      Value: true
      Color Transformer: FlatColor
      Color: 0; 255; 255
      Size (m): 0.04
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Name: DynamicCloud
      Topic: /dynamic_obj_detector/dynamic_cloud
      Value: true
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Size (m): 0.06
      Style: Points
    - Class: rviz_default_plugins/MarkerArray
      Name: StaticMarkers
      Topic: /static_obj_detector/debug_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: DynamicMarkers
      Topic: /dynamic_obj_detector/debug_markers
      Value: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Length: 10.0
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current
      Near Clip Distance: 0.01
      Pitch: 0.785398
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0.785398
    Saved: ~
